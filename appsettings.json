{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Firebase": { "ProjectId": "cober-touch-64940" },
  "Api": {
    "KeyHeader": "X-Api-Key",
    "AllowedSendIps": [],
    "KnownProxies": [ "127.0.0.1", "::1" ]
  },
  "Push": {
    "MaxTokensPerRequest": 500,
    "MaxBodyBytes": 65536,
    "DefaultTtlSeconds": 86400,
    "AndroidChannelId": "cober_general",
    "AllowedUrlHosts": [ "www.cober.com.ar", "cober.com.ar" ],
    "CanonicalUrlHost": "www.cober.com.ar",
    "AllowedUrlPathPrefix": "/app"
  },
  "RateLimiting": {
    "Send": { "PermitLimit": 60, "WindowSeconds": 60 },
    "Receipts": { "PermitLimit": 120, "WindowSeconds": 60 }
  },
  "Receipts": { "MaxAgeDays": 30 },
  "PhpApi": {
    "BaseUrl": "https://www.cober.com.ar/api/push",
    "ReadPath": "/read",
    "TimeoutSeconds": 10,
    "RetryCount": 2
  }
}
